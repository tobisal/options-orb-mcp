# ---------------------------------------------------------------------------
# Options ORB MCP System - environment configuration
# Copy this file to `.env` and adjust. NEVER commit your real `.env`.
# ---------------------------------------------------------------------------

# Interactive Brokers connection (TWS or IB Gateway must be running).
# Paper trading defaults:  TWS 7497 | IB Gateway 4002
# Live trading defaults:   TWS 7496 | IB Gateway 4001
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
# IBKR allows only one socket per clientId. This app uses IBKR_CLIENT_ID as-is
# (default 17) — one shared connection per process, no offset / walk.

# Market data type: auto | live | delayed | frozen | delayed_frozen
# "auto" requests real-time and automatically falls back to FREE 15-min delayed
# data if the account has no real-time subscription (ideal for paper accounts).
IBKR_MARKET_DATA_TYPE=auto

# Set to 1 to restore ib_async's own connection logging (for debugging).
IBKR_VERBOSE=0
# After a failed connect, skip real socket attempts for this many seconds
# (prevents log spam / retries hammering the socket while Gateway is offline).
IBKR_RETRY_COOLDOWN=30

# Account mode. MUST be "paper" unless you have deliberately gone live.
# Allowed: paper | live
ACCOUNT_MODE=paper

# IB Gateway Docker (optional). Used by docker-compose.yml / docker run.
# Paper username/password from Client Portal — not your live login.
IB_GATEWAY_USER=
IB_GATEWAY_PASSWORD=
# Optional VNC into the Gateway desktop (loopback only). Leave empty to disable.
# On EC2: ssh -L 5900:127.0.0.1:5900 user@host then VNC to 127.0.0.1:5900.
VNC_SERVER_PASSWORD=

# Hard safety interlock. Live orders are refused unless this is EXACTLY
# "I_UNDERSTAND_THE_RISK" *and* ACCOUNT_MODE=live.
LIVE_TRADING_CONFIRM=

# ---------------------------------------------------------------------------
# Capital & risk controls (all monetary values in account currency).
# ---------------------------------------------------------------------------
ACCOUNT_CURRENCY=GBP
STARTING_CAPITAL=1000

# Fraction of capital risked on a single trade (0.05 = 5%).
# NOTE: one US-options defined-risk spread (x100 multiplier) risks ~GBP 30-40,
# so at GBP 1000 a 2% cap makes even a single contract untradeable. 5% permits
# exactly one contract. Lower this as your capital grows.
MAX_RISK_PER_TRADE=0.05
# Fraction of capital that may be lost in a single day before the kill switch trips.
MAX_DAILY_LOSS=0.10
# Maximum number of simultaneously open positions (global cap).
# 9 = up to 3 session windows x 3 trades per window.
MAX_OPEN_POSITIONS=9
# Maximum simultaneously open trades per session window (Asia/London/New York).
MAX_OPEN_POSITIONS_PER_WINDOW=3

# ---------------------------------------------------------------------------
# Strategy defaults (can be overridden per-window in configs/).
# ---------------------------------------------------------------------------
# Default underlying to analyse/trade.
DEFAULT_SYMBOL=SPY
# Target reward:risk multiple for take-profit bracket.
DEFAULT_TARGET_R=1.5

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DB_PATH=data/trades.db

# ---------------------------------------------------------------------------
# Dashboard bind. Local default is loopback. Docker Compose overrides to
# 0.0.0.0 so the published 8787 port is reachable from the host.
# ---------------------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# ---------------------------------------------------------------------------
# Discord remote control (optional). Never commit the bot token.
# Create an application at https://discord.com/developers/applications
# Bot -> Reset Token. Invite URL: scopes bot + applications.commands
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
# Optional: your server id so slash commands appear immediately
DISCORD_GUILD_ID=
# Comma-separated Discord user ids allowed to run commands (Developer Mode -> Copy User ID).
# If empty, only the bot owner can run commands.
DISCORD_ALLOWED_USER_IDS=
# Channel id for live auto-trade events (fills, errors, start/stop). Right-click channel -> Copy ID.
DISCORD_LOG_CHANNEL_ID=
DISCORD_DASHBOARD_URL=http://127.0.0.1:8787
# Set 1 to also stream "no entry" cycles (noisy).
DISCORD_LOG_VERBOSE=0
